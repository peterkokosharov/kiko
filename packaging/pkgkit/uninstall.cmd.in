@echo off
REM SPDX-License-Identifier: MIT
REM Author: Peter Kokosharov <peter.kokosharov@gmail.com>
REM AI models: claude-sonnet-5-5
REM Removes @NAME@ exactly as listed in install-record.json. Options: /quiet (no pause), /purge (also data\ and logs\).
REM In the unzipped package it calls the uninstall.cmd of the installed copy; in the installed folder it runs and then
REM deletes itself and the folder.
setlocal EnableExtensions
set "QUIET="
set "PURGE="
for %%A in (%*) do (
  if /i "%%~A"=="/quiet" set "QUIET=1"
  if /i "%%~A"=="/purge" set "PURGE=--purge"
)
set "APP=%~dp0"
if "%APP:~-1%"=="\" set "APP=%APP:~0,-1%"
if not exist "%APP%\install-record.json" goto :fromzip
cd /d "%TEMP%"
set "PY="
call :try py -3
if not defined PY call :try python
if not defined PY goto :nopython
%PY% -I "%APP%\_pkg\uninstall.py" --app "%APP%" %PURGE%
set "RC=%ERRORLEVEL%"
if "%RC%"=="0" echo OK @NAME@ uninstalled
if not defined QUIET pause
if "%RC%"=="0" goto :selfdelete
exit /b %RC%

:selfdelete
(goto) 2>nul & del "%~f0" & rmdir "%APP%" 2>nul & exit /b 0

:try
%* -c "import sys; sys.exit(0 if sys.version_info >= (@MINPY_TUPLE@) else 1)" >nul 2>nul
if not errorlevel 1 set "PY=%*"
exit /b 0

:nopython
echo FAILED: Python @MINPY@ or newer was not found, so uninstall cannot run. Install Python from python.org and run uninstall again.
if not defined QUIET pause
exit /b 1

:fromzip
set "TARGET=%USERPROFILE%\apps\@NAME@"
if not exist "%TARGET%\install-record.json" (
  echo @NAME@ is not installed in %TARGET%; nothing to remove.
  if not defined QUIET pause
  exit /b 1
)
cmd /c ""%TARGET%\uninstall.cmd" %*"
exit /b %ERRORLEVEL%
